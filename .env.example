# Copy to .env and fill in real values. Never commit .env.
# Values marked [SECRET] must never be shared, pasted in chats, or committed.

# --- Discord (Developer Portal > General Information / Bot) ---
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
# [SECRET]
DISCORD_BOT_TOKEN=

# --- n8n ---
# [SECRET] Encrypts the credentials n8n stores. Must stay the same across
# restarts and deployments, or stored credentials become unreadable.
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=
# Public HTTPS URL where Discord reaches n8n (tunnel locally, HF Space later).
WEBHOOK_URL=
# Allows Code nodes to use Node's crypto module (Discord signature check).
NODE_FUNCTION_ALLOW_BUILTIN=crypto
GENERIC_TIMEZONE=America/Bogota
TZ=America/Bogota

# --- Local Postgres (docker compose, phases 2-4) ---
POSTGRES_DB=finanzas
POSTGRES_USER=finanzas
# [SECRET]
POSTGRES_PASSWORD=

# --- Supabase Postgres (phase 5, Hugging Face deployment) ---
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
# [SECRET]
SUPABASE_DB_PASSWORD=

# --- OpenRouter (phase 6, optional AI command) ---
# [SECRET]
OPENROUTER_API_KEY=
