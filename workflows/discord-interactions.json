    {
      "id": "n02",
      "name": "Verify signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\n// Public by design: Discord publishes this key so anyone can check its signatures.\nconst DISCORD_PUBLIC_KEY = '4365a7d1e5e2c8e4bcec473281cfa6a9f434cd60984589bdbaa5ac1f57b85c83';\nconst ED25519_SPKI_PREFIX = '302a300506032b6570032100';\n// Rejects replayed requests captured earlier.\nconst MAX_CLOCK_SKEW_SECONDS = 300;\nconst TRANSACTION_TYPES = { gasto: 'expense', ingreso: 'income' };\n\nconst item = $input.first();\nconst signature = String(item.json.headers['x-signature-ed25519'] || '');\nconst timestamp = String(item.json.headers['x-signature-timestamp'] || '');\n// The signature covers the exact bytes Discord sent, never the re-parsed JSON.\nconst rawBody = item.binary?.data\n  ? await this.helpers.getBinaryDataBuffer(0, 'data')\n  : Buffer.alloc(0);\n\nfunction isAuthentic() {\n  if (!/^[0-9a-f]{128}$/i.test(signature)) return false;\n  if (!/^\\d{1,12}$/.test(timestamp) || rawBody.length === 0) return false;\n  if (Math.abs(Date.now() / 1000 - Number(timestamp)) > MAX_CLOCK_SKEW_SECONDS) return false;\n  const publicKey = crypto.createPublicKey({\n    key: Buffer.from(ED25519_SPKI_PREFIX + DISCORD_PUBLIC_KEY, 'hex'),\n    format: 'der',\n    type: 'spki',\n  });\n  const signedPayload = Buffer.concat([Buffer.from(timestamp, 'utf8'), rawBody]);\n  return crypto.verify(null, signedPayload, publicKey, Buffer.from(signature, 'hex'));\n}\n\nif (!isAuthentic()) {\n  return [{ json: { authentic: false } }];\n}\n\nconst interaction = JSON.parse(rawBody.toString('utf8'));\nconst command = interaction.data?.name ?? null;\nconst options = Object.fromEntries(\n  (interaction.data?.options ?? []).map((option) => [option.name, option.value]),\n);\n\nreturn [{\n  json: {\n    authentic: true,\n    interactionType: interaction.type,\n    interactionId: interaction.id,\n    userId: interaction.member?.user?.id ?? interaction.user?.id,\n    command,\n    transactionType: TRANSACTION_TYPES[command] ?? null,\n    amount: options.monto ?? null,\n    category: options.categoria ?? null,\n    note: options.nota ?? '',\n    period: command === 'resumen' ? (options.periodo ?? 'mes') : 'mes',\n  },\n}];"
      }
    },
