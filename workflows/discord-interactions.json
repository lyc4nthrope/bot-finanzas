    {
      "id": "n11",
      "name": "Format reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1140,
        300
      ],
      "parameters": {
        "jsCode": "const request = $('Verify signature').first().json;\nconst result = $input.first().json.result;\n\nconst PERIOD_LABELS = { hoy: 'hoy', semana: 'esta semana', mes: 'este mes', 'año': 'este año' };\nconst TYPE_LABELS = { expense: 'gasto', income: 'ingreso' };\n\nfunction money(value) {\n  const amount = Number(value);\n  const digits = new Intl.NumberFormat('es-CO', { maximumFractionDigits: 0 }).format(Math.abs(amount));\n  return (amount < 0 ? '-$' : '$') + digits;\n}\n\nfunction describeRecord() {\n  if (!result.inserted) return 'Ese movimiento ya estaba registrado.';\n  if (result.type === 'expense') {\n    return `✅ Gasto registrado: ${money(result.amount)} en ${result.category}.\\n`\n      + `Gastado este mes: ${money(result.expense)}`;\n  }\n  return `✅ Ingreso registrado: ${money(result.amount)} (${result.category}).\\n`\n    + `Saldo total: ${money(result.balance)}`;\n}\n\nfunction describeBalance() {\n  return `💰 Saldo total: ${money(result.balance)}\\n`\n    + `Este mes: ingresos ${money(result.income)} · gastos ${money(result.expense)}`;\n}\n\nfunction describeSummary() {\n  const lines = [\n    `📊 Resumen de ${PERIOD_LABELS[result.period]}`,\n    `Ingresos: ${money(result.income)}`,\n    `Gastos: ${money(result.expense)}`,\n    '',\n  ];\n  if (result.by_category.length === 0) {\n    lines.push('Sin gastos en este periodo.');\n  } else {\n    lines.push('Gastos por categoría:');\n    for (const row of result.by_category) lines.push(`• ${row.category}: ${money(row.total)}`);\n  }\n  return lines.join('\\n');\n}\n\nfunction describeUndo() {\n  if (!result.deleted) return 'No hay movimientos para deshacer.';\n  return `↩️ Eliminado: ${TYPE_LABELS[result.type]} de ${money(result.amount)} (${result.category}).\\n`\n    + `Saldo total: ${money(result.balance)}`;\n}\n\nconst DESCRIBE = {\n  gasto: describeRecord,\n  ingreso: describeRecord,\n  saldo: describeBalance,\n  resumen: describeSummary,\n  deshacer: describeUndo,\n};\n\n// flags 64: only the sender sees the reply.\nreturn [{ json: { type: 4, data: { content: DESCRIBE[request.command](), flags: 64 } } }];"
      }
    },
    {
      "id": "n12",
      "name": "Build database error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1140,
        520
      ],
      "parameters": {
        "jsCode": "const request = $('Verify signature').first().json;\nconst isWrite = ['gasto', 'ingreso'].includes(request.command);\n// Never confirm a transaction that was not stored.\nconst content = isWrite\n  ? '⚠️ No pude guardar el movimiento. Intenta de nuevo en un momento.'\n  : '⚠️ Algo salió mal. Intenta de nuevo.';\nreturn [{ json: { type: 4, data: { content, flags: 64 } } }];"
      }
