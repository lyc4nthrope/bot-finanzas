    {
      "id": "n10",
      "name": "Build unknown command",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        680
      ],
      "parameters": {
        "jsCode": "return [{ json: { type: 4, data: { content: 'No conozco ese comando.', flags: 64 } } }];"
